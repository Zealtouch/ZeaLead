# --- Model ---------------------------------------------------------------
# Either set an Anthropic key here (or run `ant auth login`), or add model profiles in the
# console under System -> LLM: Anthropic, OpenAI, OpenAI-compatible gateways, Ollama or a
# Bedrock gateway. Once a profile exists, profiles are used and the lines below are ignored
# except for effort. Profile keys are stored encrypted, never in this file.
ANTHROPIC_API_KEY=
ZEALEAD_PLANNER_MODEL=claude-opus-5-5
ZEALEAD_WORKER_MODEL=claude-opus-5-5
ZEALEAD_PLANNER_EFFORT=high
ZEALEAD_WORKER_EFFORT=medium
# Drafts a personalised public reply + direct message for every lead (defaults to the worker model)
ZEALEAD_WRITER_MODEL=claude-opus-5-5
ZEALEAD_WRITER_EFFORT=low
# 1 = draft messages automatically as leads are found; 0 = only on request
ZEALEAD_AUTO_DRAFT=1
# Server-side refusal fallback (default | off)
ZEALEAD_FALLBACKS=default

# --- Engine ---------------------------------------------------------------
# Database path when running without Docker (Docker keeps it in a volume).
ZEALEAD_DB=zealead.db
ZEALEAD_WORKERS=3
# Whole campaign, planner + workers, in tokens (input+output+cache). 0 = unlimited.
ZEALEAD_BUDGET_TOKENS=3000000
ZEALEAD_INTENT_MAX_TURNS=25
ZEALEAD_PLANNER_MAX_TURNS=12
ZEALEAD_HEARTBEAT_SECONDS=90
ZEALEAD_STAGNATION_ROUNDS=10
# quiet | balanced | aggressive (per-host request pacing)
ZEALEAD_NOISE_PROFILE=balanced

# --- Platforms (each one is optional) ---------------------------------------
# Hacker News and Stack Exchange need no key and are always on.

# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
# Required for the Reddit connector: Reddit blocks unauthenticated API clients.
# Without them, Reddit is still reachable through web_search (site:reddit.com).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# X / Twitter API v2 recent search (paid tier). Without it, X is reached via web_search snippets.
X_BEARER_TOKEN=

# Bluesky: Settings -> App passwords
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# GitHub issues search
GITHUB_TOKEN=

# Web search: LinkedIn, G2, Capterra, Trustpilot, Product Hunt, Quora, Indie Hackers, forums.
# One of these is strongly recommended.
BRAVE_API_KEY=
TAVILY_API_KEY=

# Optional: higher Stack Exchange quota
STACKEXCHANGE_KEY=

# --- Docker -----------------------------------------------------------------
# Host address/port the console is published on. Keep 127.0.0.1 unless a TLS
# reverse proxy sits in front.
ZEALEAD_PUBLISH_ADDR=127.0.0.1
ZEALEAD_PUBLISH_PORT=8790
